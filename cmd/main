#!/bin/bash

# ========== 基础配置（全局保留） ==========
LOG_FILE="${TRIM_APPDEST_VOL}/@appshare/${TRIM_APPNAME}/fndesk日志.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
# ========== 初始化日志（全局保留，确保日志文件存在） ==========
mkdir -p "$(dirname "${LOG_FILE}")" || exit 1
touch "${LOG_FILE}" || exit 1
# ========== 脚本自身输出重定向（全局保留） ==========
exec >> "${LOG_FILE}" 2>&1
# ========== 日志裁剪函数（全局保留） ==========
trim_log() {
    if [ -f "${LOG_FILE}" ]; then
        local line_count=$(wc -l < "${LOG_FILE}")
        if [ "${line_count}" -gt 100 ]; then
            sed -i -e :a -e '$q;N;51,$D;ba' "${LOG_FILE}"
            echo "$(date '+%Y-%m-%d %H:%M:%S') - ✅ 日志已裁剪，保留最后100行"
        fi
    fi
}
# ========== 进程检查函数（全局保留） ==========
check_process() {
    local pid=$1
    kill -0 "${pid}" 2>/dev/null && return 0 || return 1
}
# ========== status函数（仅检查进程，无检测/下载） ==========
status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi    
    fi
    return 1
}
# ========== stop函数（仅停止进程，无检测/下载） ==========
stop_process() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - 🛑 飞牛系统停止了 ${TRIM_APPNAME} 应用..."
    # ========== 原有逻辑：杀PID文件里的进程 ==========
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        if check_process "${pid}"; then
            # 优雅停止
            kill -TERM ${pid}
            # 等待10秒
            local count=0
            while check_process "${pid}" && [ $count -lt 10 ]; do
                sleep 1
                count=$((count + 1))
            done
            # 强制杀死
            if check_process "${pid}"; then
                kill -KILL "${pid}"
                sleep 1
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    # ========== 残留进程清理（⚠️ 注意：这里我把原来node匹配改成二进制路径匹配！） ==========
    pkill -f "${TRIM_APPDEST}/server/fndesk-go" || true
    sleep 2
    pkill -9 -f "${TRIM_APPDEST}/server/fndesk-go" || true
    return 0
}
# ========== start函数（纯二进制启动，全部node逻辑删除） ==========
start_process() {
    echo ""
    echo "-------------- -【$(date '+%Y-%m-%d %H:%M:%S')】- --------------"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ℹ️ 飞牛系统启动了 ${TRIM_APPNAME} 应用..."
    # 第一步：先检查进程是否已运行，避免重复启动
    if status; then
        return 0
    fi
    # ========== 直接启动二进制 ==========
    # echo "$(date '+%Y-%m-%d %H:%M:%S') - ✅ 系统架构${TRIM_SYS_ARCH} ✅ 飞牛版本${TRIM_SYS_VERSION} ✅ Fndesk版本${TRIM_APPVER}"
    CMD="${TRIM_APPDEST}/server/fndesk-go"
    bash -c "${CMD} >> ${LOG_FILE} 2>&1" &
    local app_pid=$!
    printf "%s" "${app_pid}" > ${PID_FILE}
    return 0
}
# ========== 脚本入口（分发指令） ==========
case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    trim_log
    ;;
status)
    status
    ret=$?
    if [ $ret -eq 0 ]; then
        exit 0
    else
        start_process
        exit $?
    fi
    ;;
*)
    exit 1
    ;;
esac